{
  "$schema": "https://yourdomain.dev/schemas/pip-conflict-schema-v1.json",
  "version": "2025.08.03",
  "description": "Known pip-level package conflicts for proactive stdlib-check inspection",
  "conflict_table": [
    {
      "packages": ["numpy", "tensorflow"],
      "scope": "runtime",
      "platform": ["any"],
      "python_versions": ["3.8", "3.9", "3.10", "3.11", "3.12"],
      "symptoms": ["ImportError", "Segfault", "Silent failure in eager mode"],
      "example_matrix": [
        {
          "numpy": "<1.24",
          "tensorflow": ">=2.11.0",
          "status": "incompatible",
          "notes": "TensorFlow drops support for newer NumPy ABI past 1.23"
        }
      ],
      "resolution": {
        "pin": {"numpy": "1.23.5"},
        "suggest": "Use tensorflow>=2.11 only with numpy<=1.23.5"
      }
    },
    {
      "packages": ["matplotlib", "pyqt5"],
      "scope": "GUI backend",
      "platform": ["Windows", "Linux"],
      "python_versions": ["3.8+"],
      "symptoms": ["Backend failure", "Segfault on render", "Missing display"],
      "example_matrix": [
        {
          "matplotlib": ">=3.4",
          "pyqt5": "<5.15",
          "status": "partial failure",
          "notes": "Agg and TkAgg backends work; Qt5Agg may not"
        }
      ],
      "resolution": {
        "pin": {"pyqt5": ">=5.15.2"},
        "suggest": "Change backend or update PyQt5"
      }
    },
    {
      "packages": ["pandas", "pyarrow"],
      "scope": "Data exchange",
      "platform": ["any"],
      "python_versions": ["3.9+"],
      "symptoms": ["Arrow table export fails", "Schema mismatch"],
      "example_matrix": [
        {
          "pandas": ">=1.5",
          "pyarrow": "<10",
          "status": "runtime error",
          "notes": "Parquet schema mapping breaks due to deprecated interfaces"
        }
      ],
      "resolution": {
        "pin": {"pyarrow": ">=11.0"},
        "suggest": "Ensure pyarrow matches pandas feature set"
      }
    }
  ],
  "curation": {
    "source": "community and upstream changelogs",
    "maintenance": "manual updates via stdlib-check JSON curator module",
    "verified": true
  }
}
